{
  "name": "eduasset-pro",
  "version": "2.5.0",
  "description": "科技信息中心固定资产登记平台 — School Fixed Asset Management System",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "audit:eng": "node .eng-audit/summarize.mjs sonar.json \"SonarSource 官方默认值（JS/TS）\"",
    "build": "vite build",
    "client": "vite",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "lint": "eslint .",
    "lint:arch": "node .eng-audit/run-arch.mjs \"SonarSource 官方默认值（JS/TS）\"",
    "lint:design": "node .eng-audit/design-scan.mjs",
    "lint:orphan": "node .eng-audit/orphan-scan.mjs",
    "server": "node server.js",
    "setup": "npm install && echo '✅ 依赖安装完成。请确保 .env 文件已配置，然后运行 npm start 启动系统。'",
    "start": "npm run build && node server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:coverage": "tsc -p .eng-audit/tsconfig.coverage.json"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@tailwindcss/vite": "^4.3.1",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "glob": "^13.0.6",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "path": "^0.12.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^4.3.1",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "impeccable": "^2.3.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.0"
  }
}
